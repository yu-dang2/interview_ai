# OpenAI API 키
OPENAI_API_KEY=본인_키_입력

# DB 접속 정보. 미지정 시 sqlite:///./lang_king.db 로 떨어진다.
# MySQL 사용 시 (비밀번호에 @ : / 같은 특수문자가 있으면 URL 인코딩 필요)
DATABASE_URL=mysql+pymysql://interview_ai:본인_비밀번호_입력@127.0.0.1:3306/interview_ai?charset=utf8mb4

# JWT 서명 키. 미지정 시 서버 기동마다 새로 생성되어 재시작하면 토큰이 무효가 된다.
# 통합 테스트·배포 환경에서는 반드시 고정값을 넣을 것.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# 액세스 토큰 만료(분). 기본 1440분(24시간).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 배포 ───────────────────────────────────────────────
# production 이면 /test-llm 같은 디버그 엔드포인트가 노출되지 않는다.
ENVIRONMENT=development

# CORS 허용 출처(쉼표 구분). 배포 시 실제 프론트 주소로 바꿀 것.
# "*" 를 쓰면 아무 사이트에서나 토큰을 실어 API 를 호출할 수 있다.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ── 사용량 제한 ────────────────────────────────────────
# 면접 1회에 LLM 호출이 십수 번 나가므로 세션 생성 횟수로 비용을 막는다.
# ※ 아래 값은 임시값이며 회의에서 논의 예정이다.
# 0 이하면 제한 없음.
INTERVIEW_DAILY_LIMIT=10
INTERVIEW_ACTIVE_LIMIT=3

# ── 구글 로그인 (OAuth 2.0) ────────────────────────────
# 비워 두면 /auth/google 이 501 을 돌려주고 이메일 로그인만 동작한다.
# 값은 구글 클라우드 콘솔 > API 및 서비스 > 사용자 인증 정보에서 받는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 구글이 인증을 마치고 사용자를 돌려보낼 주소.
# 콘솔의 "승인된 리디렉션 URI" 와 글자 하나까지 같아야 한다. 와일드카드는 안 된다.
# 로컬과 배포 주소를 콘솔에 둘 다 등록해 두고 여기서 골라 쓴다.
#   로컬   http://localhost:8000/auth/google/callback
#   배포   https://<주소>/api/auth/google/callback      ← 프록시를 거쳐 /api 가 붙는다
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# 로그인을 마친 사용자를 돌려보낼 화면 주소.
# 브라우저가 찾아가는 주소라 컨테이너 이름(web)을 쓰면 안 된다.
FRONTEND_BASE_URL=http://localhost:8501

# ── 면접 시간 ──────────────────────────────────────────
# 제한 시간(분). 화면 타이머와 서버 검사가 같은 값을 읽는다.
# compose 에서 api 와 web 양쪽에 전달되므로 한 줄만 바꾸면 둘 다 따라간다.
INTERVIEW_TIME_LIMIT_MIN=30

# 브라우저를 그냥 닫으면 종료 요청이 오지 않아 세션이 active 로 남는다.
# 이 시간이 지난 active 는 세션 생성 시 자동으로 정리한다. 기본 제한 시간의 2배.
INTERVIEW_STALE_AFTER_MIN=60

# ── 결과 리포트 생성 ───────────────────────────────────
# 면접 종료는 접수(202)만 하고 리포트는 백그라운드에서 만든다.
# GET /result 가 완성을 기다리는 시간(초). 넘기면 503 으로 "생성 중"을 알린다.
# 화면의 get_result 타임아웃(180초)보다 짧아야 한다.
# 150초는 실측 8회(62~245초, 중앙값 126초)를 기준으로 잡은 타협값이다.
REPORT_WAIT_TIMEOUT_SEC=150

# 완성 여부를 다시 확인하는 간격(초).
REPORT_POLL_INTERVAL_SEC=1.5

# ── docker compose 전용 ────────────────────────────────
# compose 로 띄울 때만 쓴다. 로컬 실행 시에는 DATABASE_URL 만 있으면 된다.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=interview_ai
MYSQL_USER=interview_ai
MYSQL_PASSWORD=interview_ai!

# ── 직무 지식 검색(RAG) ────────────────────────────────
# 전부 선택 항목이다. 지정하지 않아도 기본값으로 동작한다.
#
# 인덱스는 커밋하지 않으므로 각자 한 번 만들어야 한다:
#   python scripts/build_knowledge_index.py
# 만들지 않아도 서버는 정상 기동하며, 참고자료 없이 질문을 생성한다(기능 저하일 뿐 오류 아님).

# 벡터 인덱스 디렉터리. 기본 ./data/knowledge_index
# 구/신 코퍼스를 비교할 때만 다른 경로를 쓰면 된다.
# CHROMA_DB_PATH 가 아니라 KNOWLEDGE_INDEX_PATH 다.
KNOWLEDGE_INDEX_PATH=./data/knowledge_index

# 임베딩 모델. 기본 text-embedding-3-small
# 바꾸면 인덱스를 반드시 다시 만들어야 한다(차원·벡터 공간이 달라 검색이 조용히 망가진다).
# Chroma 기본 임베딩(다국어 성능이 낮음)을 쓰지 않고 이 모델을 명시 지정한다.
EMBEDDING_MODEL=text-embedding-3-small

# 이 거리를 넘는 카드는 "관련 없음"으로 보고 버린다. 기본 0.6
# 실측 근거(직무 6종): 정답 카드 0.30~0.47 / 2위 카드 0.55~0.65 / 무관한 쿼리 0.79~0.84.
# 코퍼스를 크게 늘리면 분포가 달라지므로 재측정할 것.
# 확인: python scripts/compare_question_quality.py --search-only
KNOWLEDGE_MAX_DISTANCE=0.6

# ── 영상 분석 ──────────────────────────────────────────
# 업로드된 면접 영상을 두는 경로. 경로에 한글이 들어가면 OpenCV가 파일을 열지 못한다.
VIDEO_STORAGE_DIR=./uploads/videos

# 사용자당 보관 영상 개수. 초과분은 오래된 것부터 삭제된다.
VIDEO_MAX_PER_USER=3

# N프레임마다 1장만 분석. 1이면 30분 영상 분석에 30분 걸린다.
VIDEO_SAMPLE_EVERY=15

# 업로드 크기 상한(MB).
VIDEO_MAX_UPLOAD_MB=200

# 이 시간을 넘겨도 분석이 안 끝나면 실패로 처리한다(분).
# 분석 중 서버가 죽으면 상태가 영영 analyzing 으로 남는 것을 막는다.
VIDEO_ANALYZE_TIMEOUT_MIN=30

# ── 화면(Streamlit) ────────────────────────────────────
# 백엔드 주소가 두 벌인 이유:
#
#   API_BASE_URL         Streamlit 서버가 백엔드를 부를 때 쓴다.
#                        docker compose 로 띄우면 컨테이너끼리 통신하므로
#                        서비스 이름(api)을 쓴다. 로컬에서 그냥 실행하면 127.0.0.1.
#   PUBLIC_API_BASE_URL  화면의 자바스크립트가 부를 때 쓴다. 음성 업로드처럼
#                        사용자 브라우저에서 나가는 요청이라 밖에서 닿는 주소여야 한다.
#                        여기에 http://api:8000 을 넣으면 사용자 PC 가 찾지 못해 실패한다.
#
# 배포할 때는 PUBLIC_API_BASE_URL 과 위쪽 CORS_ORIGINS 를 실제 주소로 바꾼다.
API_BASE_URL=http://127.0.0.1:8000
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ── 질문 음성 안내 (Google Cloud TTS) ──────────────────
# Streamlit 서버가 직접 호출한다. 백엔드를 거치지 않으므로 api 가 아니라 web 쪽 값이다.
# 브라우저에서 부르면 키가 그대로 노출되기 때문에 서버에서 부른다.
#
# 키가 비어 있어도 화면은 정상 동작한다. 브라우저 내장 음성으로 넘어갈 뿐이다.
# 그래서 키를 안 넣으면 에러 없이 조용히 다른 목소리가 나온다 — 배포 후 한 번 들어볼 것.
GOOGLE_TTS_API_KEY=

# 면접관별 목소리(Chirp 3 HD). 비워 두면 아래 기본값을 쓴다.
GOOGLE_TTS_VOICE_TECH=ko-KR-Chirp3-HD-Iapetus
GOOGLE_TTS_VOICE_HR=ko-KR-Chirp3-HD-Vindemiatrix
GOOGLE_TTS_VOICE_EXEC=ko-KR-Chirp3-HD-Algieba

# 말하기 속도(0.25~4.0)와 한 번에 읽을 글자수 상한.
GOOGLE_TTS_SPEAKING_RATE=1.0
TTS_MAX_CHARS=600

# ── 화면의 영상 대기 시간 ──────────────────────────────
# 면접 종료 화면에서 업로드를 기다리는 시간(초).
# 넘겨도 실패로 표시하지 않는다. 업로드는 브라우저에서 계속 진행되어 실제로 저장된다.
# 배포 서버가 시드니 리전이라 30분 면접(100MB 안팎)이면 30~60초를 권한다.
VIDEO_UPLOAD_WAIT_SEC=20

# 결과 화면에서 업로드 중인 영상을 "저장 중"으로 기다리는 시간(초).
VIDEO_RESULT_WAIT_SEC=120
