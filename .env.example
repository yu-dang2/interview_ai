# OpenAI API 키
OPENAI_API_KEY=본인_키_입력

# DB 접속 정보. 미지정 시 sqlite:///./lang_king.db 로 떨어진다.
# MySQL 사용 시 (비밀번호에 @ : / 같은 특수문자가 있으면 URL 인코딩 필요)
DATABASE_URL=mysql+pymysql://interview_ai:본인_비밀번호_입력@127.0.0.1:3306/interview_ai?charset=utf8mb4

# JWT 서명 키. 미지정 시 서버 기동마다 새로 생성되어 재시작하면 토큰이 무효가 된다.
# 통합 테스트·배포 환경에서는 반드시 고정값을 넣을 것.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# 액세스 토큰 만료(분). 기본 1440분(24시간).
ACCESS_TOKEN_EXPIRE_MINUTES=1440
