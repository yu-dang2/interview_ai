# OpenAI API 키
OPENAI_API_KEY=본인_키_입력

# DB 접속 정보. 미지정 시 sqlite:///./lang_king.db 로 떨어진다.
# MySQL 사용 시 (비밀번호에 @ : / 같은 특수문자가 있으면 URL 인코딩 필요)
DATABASE_URL=mysql+pymysql://interview_ai:본인_비밀번호_입력@127.0.0.1:3306/interview_ai?charset=utf8mb4

# JWT 서명 키. 미지정 시 서버 기동마다 새로 생성되어 재시작하면 토큰이 무효가 된다.
# 통합 테스트·배포 환경에서는 반드시 고정값을 넣을 것.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# 액세스 토큰 만료(분). 기본 1440분(24시간).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 배포 ───────────────────────────────────────────────
# production 이면 /test-llm 같은 디버그 엔드포인트가 노출되지 않는다.
ENVIRONMENT=development

# CORS 허용 출처(쉼표 구분). 배포 시 실제 프론트 주소로 바꿀 것.
# "*" 를 쓰면 아무 사이트에서나 토큰을 실어 API 를 호출할 수 있다.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ── 사용량 제한 ────────────────────────────────────────
# 면접 1회에 LLM 호출이 십수 번 나가므로 세션 생성 횟수로 비용을 막는다.
# ※ 아래 값은 임시값이며 회의에서 논의 예정이다.
# 0 이하면 제한 없음.
INTERVIEW_DAILY_LIMIT=10
INTERVIEW_ACTIVE_LIMIT=3

# ── docker compose 전용 ────────────────────────────────
# compose 로 띄울 때만 쓴다. 로컬 실행 시에는 DATABASE_URL 만 있으면 된다.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=interview_ai
MYSQL_USER=interview_ai
MYSQL_PASSWORD=interview_ai!

# ── 영상 분석 ──────────────────────────────────────────
# 업로드된 면접 영상을 두는 경로. 경로에 한글이 들어가면 OpenCV가 파일을 열지 못한다.
VIDEO_STORAGE_DIR=./uploads/videos

# 사용자당 보관 영상 개수. 초과분은 오래된 것부터 삭제된다.
VIDEO_MAX_PER_USER=3

# N프레임마다 1장만 분석. 1이면 30분 영상 분석에 30분 걸린다.
VIDEO_SAMPLE_EVERY=15

# 업로드 크기 상한(MB).
VIDEO_MAX_UPLOAD_MB=200

# 이 시간을 넘겨도 분석이 안 끝나면 실패로 처리한다(분).
# 분석 중 서버가 죽으면 상태가 영영 analyzing 으로 남는 것을 막는다.
VIDEO_ANALYZE_TIMEOUT_MIN=30
